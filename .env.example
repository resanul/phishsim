# Copy to .env and fill in real values. Never commit .env to version control.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-value
BASE_URL=http://localhost:9988

# Host/port the server binds to (read by scripts/run_server.sh and the
# systemd unit -- NOT read by the FastAPI app itself). 0.0.0.0 means
# reachable from other machines on the network; restrict with a firewall
# rule if this server also runs other services you don't want exposed.
APP_HOST=0.0.0.0
APP_PORT=9988

# postgresql+psycopg://phishsim:changeme@localhost:5432/phishsim
DATABASE_URL=postgresql+psycopg://phishsim:changeme@localhost:5432/phishsim

REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=phishsim_session
SESSION_COOKIE_SECURE=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
REQUIRE_MFA_FOR_ADMINS=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
DEFAULT_SENDER_NAME=IT Security
DEFAULT_SENDER_EMAIL=security-awareness@example.org
MAX_EMAILS_PER_MINUTE=30

# Comma-separated list of internal domains this platform is authorized to target
APPROVED_RECIPIENT_DOMAINS=example.org

TEST_MODE_DEFAULT=true
DEFAULT_RETENTION_DAYS=180
TRACKING_TOKEN_BYTES=32
